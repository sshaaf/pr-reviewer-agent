# Copy to agent/.env and fill in. Loaded by smoke-test.sh and e2e-review-smoke.sh.
#   cp agent/.env.example agent/.env

# ── LLM provider selection ──────────────────────────────────────────────────
# litellm (default) | openai
LLM_PROVIDER=litellm
# Optional full override: openai/gpt-4o or litellm/Qwen3.6-35B-A3B
# OPENCODE_MODEL=

# ── LiteLLM / OpenAI-compatible proxy ───────────────────────────────────────
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# ── OpenAI (native) ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── OpenCode HTTP basic auth (container) ────────────────────────────────────
OPENCODE_SERVER_PASSWORD=e2e-smoke-secret
SMOKE_TEST_PASSWORD=e2e-smoke-secret

# ── rgctl resource limits (containers / K8s agent pods) ─────────────────────
# Spec for `rgctl discover --with-limits` (also via env RGCTL_WITH_LIMITS):
#   max-mem-mb|max-mem|memory-mb  — soft RSS (warn ~90%, abort ~95%)
#   threads|thread|max-thread|max-threads — Rayon worker cap for discover/CFG
# Keep max-mem-mb below the pod memory limit with headroom for OpenCode.
RGCTL_WITH_LIMITS=max-mem-mb=1536,threads=1

# ── Fixture / image overrides (optional) ────────────────────────────────────
# IMAGE=pr-reviewer-agent:latest
# COOLSTORE_PATH=/Users/sshaaf/git/rust/rbuilder/example/coolstore-weblogic
# COOLSTORE_URL=https://github.com/sshaaf/coolstore-weblogic.git
# E2E_TIMEOUT_SECONDS=900
# E2E_HOST_PORT=14096
# E2E_KEEP_WORK=0
# E2E_RUNS_DIR=   # default: agent/e2e-runs/<timestamp>-id/
